{
  // Stabl : API + application web servies par un seul Worker (même origine, cookies simples).
  "name": "piaffe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/ics/*", "/auth/*", "/webhooks/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "piaffe", "database_id": "REMPLACER_PAR_L_ID_D1", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "piaffe-files" }],
  // Robot de migration (lot F) : navigateur Browser Rendering et un Durable Object par session.
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "ROBOT", "class_name": "RobotSession" }] },
  "migrations": [{ "tag": "robot-v1", "new_sqlite_classes": ["RobotSession"] }],
  "triggers": { "crons": ["*/10 * * * *", "0 6 * * *"] },
  "vars": {
    "APP_URL": "http://localhost:8787",
    "MAIL_FROM": "Stabl <bonjour@stablapp.fr>",
    "MAIL_PROVIDER": "log",
    "EINVOICE_PROVIDER": "sandbox",
    "PLATFORM_LEGAL_NAME": "Marceau Ruis EI",
    "PLATFORM_TRADE_NAME": "Ruis Global",
    "PLATFORM_SIREN": "934733122",
    "PLATFORM_SIRET": "93473312200014",
    "PLATFORM_ADDRESS": "36 rue Jacques-Louis Hénon, 69004 Lyon, France",
    "PLATFORM_VAT_REGIME": "franchise",
    "PLATFORM_LEGAL_NOTE": "Entrepreneur individuel, micro-entreprise, dispensé d’immatriculation au RCS. APE 70.22Z"
  }
  // Secrets (wrangler secret put …) : SESSION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_CONNECT_WEBHOOK_SECRET, MAIL_API_KEY, MAIL_WEBHOOK_SECRET, EINVOICE_API_KEY, BILLING_ADMIN_SECRET
}
